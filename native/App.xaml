<Application
    x:Class="HybridIntelligenceRetail.ShowcaseApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#0F6E6E</Color>
            <Color x:Key="SystemAccentColorLight1">#2E8B8B</Color>
            <Color x:Key="SystemAccentColorLight2">#5FAFAF</Color>
            <Color x:Key="SystemAccentColorLight3">#A9D6D6</Color>
            <Color x:Key="SystemAccentColorDark1">#0C5C5C</Color>
            <Color x:Key="SystemAccentColorDark2">#0A4B4B</Color>
            <Color x:Key="SystemAccentColorDark3">#073838</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
